# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id. Cheap+good default; swap for a stronger one if extraction quality is poor.
OPENROUTER_MODEL=google/gemini-2.5-flash

# To use OmniRoute (local gateway) instead of OpenRouter:
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=<key created in the OmniRoute dashboard>
# OPENROUTER_MODEL=<a model/combo name shown in OmniRoute>
